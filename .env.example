# Copy this file to .env and fill in the values before running the app.

# SQLite file for local/trial use. For a real multi-tenant deployment, point
# this at a hosted Postgres instance instead (see README "Deploy" section).
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
