# Copy this file to .env and fill in the values before running the app.

# Postgres connection string. Locally: install Postgres and create a database,
# or point this at the same hosted database you use in production (Vercel
# Storage / Neon, Supabase, Railway...). See README "Deploy" section.
DATABASE_URL="postgresql://user:password@localhost:5432/reviewapp"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Resend API key for the negative-feedback email alert (resend.com/api-keys).
# Leave blank to disable the alert — feedback submission still works fine
# without it, the email is just skipped.
RESEND_API_KEY=""

# Sender shown on that email. Resend's own onboarding.resend.dev address
# works with no setup; swap in your own verified domain once you have one.
NOTIFICATION_FROM_EMAIL="Recensioni Smart <onboarding@resend.dev>"

# Anthropic API key for the automatic feedback analysis (console.anthropic.com).
# Leave blank to disable — the "Analisi" tab explains it's not configured
# instead of generating one.
ANTHROPIC_API_KEY=""
